# systemd-Unit für den Agenten.
# Einfachste Installation: sudo sh install-agent.sh --server wss://… (siehe deploy/install-agent.sh)
# Von Hand (auf dem Zielsystem, als root):
#   install -m 0755 mat-agent-linux-<arch> /usr/local/bin/mat-agent
#   install -d -m 0700 /etc/mat-agent
#   install -m 0600 agent.example.json /etc/mat-agent/agent.json   # anpassen!
#   install -m 0644 mat-agent.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now mat-agent

[Unit]
Description=MAT Agent (Monitoring and Administration Tool)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mat-agent -config /etc/mat-agent/agent.json
Restart=always
RestartSec=5

# Läuft als root, weil Admin-Jobs (Pakete, Neustart) ausgeführt werden.
User=root
# Hält den Agenten selbst klein (Ziel im Betrieb: 10–25 MB). Bewusst kein
# MemoryMax: Die Grenze gälte für die ganze Unit, also auch für apt-get und
# dpkg aus einem Paket-Job; ein OOM-Kill mitten im Upgrade hinterließe halb
# installierte Pakete.
Environment=GOMEMLIMIT=20MiB
# Beim Neustart oder Absturz des Agenten nur ihn selbst beenden, nicht ein
# laufendes apt-get/dpkg (das Upgrade läuft dann zu Ende).
KillMode=process

# Härtung, die die Admin-Jobs nicht einschränkt.
NoNewPrivileges=yes
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
