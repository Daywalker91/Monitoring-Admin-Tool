# Vorlage für mat-server -env-file (KEY=VALUE, # für Kommentare).
# Kopieren nach data\server.env (wird von Git ignoriert) und Werte eintragen.
# Bereits gesetzte Umgebungsvariablen haben Vorrang vor der Datei.

MAT_AGENT_TOKEN=<langes-zufälliges-token>
MAT_LISTEN=:8080

# Optional
# MAT_DB=C:\ProgramData\mat-server\mat.db
# MAT_TLS_CERT=C:\ProgramData\mat-server\server.crt
# MAT_TLS_KEY=C:\ProgramData\mat-server\server.key
# MAT_METRICS_TOKEN=<mindestens 16 zeichen>
# MAT_TRUSTED_PROXIES=10.42.0.0/16
# MAT_LOG_LEVEL=info

# Benachrichtigungen (siehe README, Abschnitt Alarme)
# MAT_NTFY_URL=https://ntfy.sh/<schwer-erratbares-topic>
# MAT_NTFY_TOKEN=tk_...
# MAT_SMTP_HOST=smtp.example.com
# MAT_SMTP_PORT=587
# MAT_SMTP_TLS=starttls
# MAT_SMTP_USER=monitor@example.com
# MAT_SMTP_PASS=...
# MAT_SMTP_FROM=Homelab Monitor <monitor@example.com>
# MAT_SMTP_TO=ich@example.com
